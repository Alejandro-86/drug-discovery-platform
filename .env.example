# Copy to .env and fill in your values. Never commit .env.

# PostgreSQL
POSTGRES_DB=drug_discovery
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_URL=postgresql+asyncpg://your_pg_user:your_pg_password@localhost:5432/drug_discovery

# MongoDB (no auth by default for local dev)
MONGO_URL=mongodb://localhost:27017

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Qdrant (no auth by default)
QDRANT_URL=http://localhost:6333

# NCBI API key (optional — increases rate limit from 3 to 10 req/s)
# Register free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
